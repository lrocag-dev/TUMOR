func real dr(real t){
        return (-sin(2*t));
     //   return (0);
}
func real d2r(real t){
        return (-2*cos(2*t));
     //   return (0);
}
func real kpolar(real t){
        return (2*dr(t)^2+rt(t)^2-rt(t)*d2r(t))/(dr(t)^2+rt(t)^2)^(1.5);
}
border circ(t=0,2*pi){ x=rt(t)*cos(t); y=rt(t)*sin(t);}

