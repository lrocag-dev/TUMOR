// Curvatura por diferencias centrales de 2.o orden (malla cuadrada, paso = lado de la malla):
// kappa = (phi_xx phi_y^2 - 2 phi_x phi_y phi_xy + phi_yy phi_x^2)/|grad phi|^3
int usekfd=1;  // 1: diferencias centrales, 2: formulacion variacional (proyeccion L2 de div N_h), 0: aproximacion debil original
real sgk=0.01; // penalizacion fantasma de la formulacion variacional
macro kfdexpr(d) ( ( (phih(x+d,y)-2.*phih(x,y)+phih(x-d,y))/(d*d) * ((phih(x,y+d)-phih(x,y-d))/(2.*d))^2 - 2.*((phih(x+d,y)-phih(x-d,y))/(2.*d))*((phih(x,y+d)-phih(x,y-d))/(2.*d))*((phih(x+d,y+d)-phih(x+d,y-d)-phih(x-d,y+d)+phih(x-d,y-d))/(4.*d*d)) + (phih(x,y+d)-2.*phih(x,y)+phih(x,y-d))/(d*d) * ((phih(x+d,y)-phih(x-d,y))/(2.*d))^2 ) / (((phih(x+d,y)-phih(x-d,y))/(2.*d))^2+((phih(x,y+d)-phih(x,y-d))/(2.*d))^2+1e-12)^1.5 ) //EOM

